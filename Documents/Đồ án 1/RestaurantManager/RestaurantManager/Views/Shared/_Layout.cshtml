<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Nhà hàng Hải 79</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg navbar-dark sticky-top app-navbar shadow-sm">
        <div class="container-fluid px-lg-4">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                <i class="bi bi-shop-window me-2"></i>Hải 79
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-book me-1"></i>Thực đơn</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="DatBan" asp-action="PublicCreate"><i class="bi bi-calendar2-check me-1"></i>Đặt bàn</a></li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Dashboard"><i class="bi bi-speedometer2 me-1"></i>Tổng quan</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="BanAn" asp-action="Index"><i class="bi bi-grid-3x3-gap me-1"></i>Bàn</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="DatBan" asp-action="Index"><i class="bi bi-calendar-event me-1"></i>Lịch đặt</a></li>
                        @if (User.IsInRole(RoleNames.QuanLy) || User.IsInRole(RoleNames.PhucVu))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="DonGoiMon" asp-action="Index"><i class="bi bi-receipt-cutoff me-1"></i>Gọi món</a></li>
                        }
                        @if (User.IsInRole(RoleNames.QuanLy) || User.IsInRole(RoleNames.ThuNgan))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="HoaDon" asp-action="Pending"><i class="bi bi-cash-coin me-1"></i>Thanh toán</a></li>
                        }
                        @if (User.IsInRole(RoleNames.QuanLy) || User.IsInRole(RoleNames.QuanTriVien))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown"><i class="bi bi-gear me-1"></i>Quản lý</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="DanhMuc" asp-action="Index">Danh mục món</a></li>
                                    <li><a class="dropdown-item" asp-controller="MonAn" asp-action="Index">Món ăn</a></li>
                                    <li><a class="dropdown-item" asp-controller="KhachHang" asp-action="Index">Khách hàng</a></li>
                                    <li><a class="dropdown-item" asp-controller="HoaDon" asp-action="Index">Hóa đơn</a></li>
                                    <li><a class="dropdown-item" asp-controller="ThongKe" asp-action="Index">Thống kê</a></li>
                                    @if (User.IsInRole(RoleNames.QuanTriVien))
                                    {
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><a class="dropdown-item" asp-controller="NguoiDung" asp-action="Index">Tài khoản</a></li>
                                    }
                                </ul>
                            </li>
                        }
                    }
                </ul>
                <div class="d-flex align-items-center gap-2 text-white">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="dropdown">
                            <button class="btn btn-outline-light btn-sm dropdown-toggle" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle me-1"></i>@User.Identity.Name
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">Đổi mật khẩu</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button class="dropdown-item text-danger" type="submit">Đăng xuất</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="btn btn-light btn-sm" asp-controller="Account" asp-action="Login"><i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập</a>
                    }
                </div>
            </div>
        </div>
    </nav>
</header>

<main class="container-fluid px-lg-4 py-4 min-vh-100">
    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle me-2"></i>@success
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@error
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @RenderBody()
</main>

<footer class="border-top py-3 bg-white">
    <div class="container-fluid px-lg-4 d-flex justify-content-between small text-secondary">
        <span>© @DateTime.Now.Year Nhà hàng Hải 79</span>
        <span>Hải - Cường - Long - Long</span>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
