@model IEnumerable<MonAn>
@{
    ViewData["Title"] = "Thực đơn";
    var categories = ViewBag.Categories as IEnumerable<DanhMucMonAn> ?? Enumerable.Empty<DanhMucMonAn>();
}
<section class="hero-panel mb-4">
    <div class="row align-items-center g-4">
        <div class="col-lg-7">
            <span class="badge rounded-pill text-bg-light text-success mb-3">Ẩm thực Hải 79 · Phục vụ tận tâm</span>
            <h1 class="display-5 fw-bold">Quản lý thông minh,<br />trải nghiệm trọn vị</h1>
            <p class="lead opacity-75">Khám phá thực đơn, đặt bàn trực tuyến và để đội ngũ nhà hàng phục vụ bạn nhanh chóng.</p>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-light btn-lg" asp-controller="DatBan" asp-action="PublicCreate"><i class="bi bi-calendar2-check me-2"></i>Đặt bàn ngay</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="btn btn-outline-light btn-lg" asp-action="Dashboard"><i class="bi bi-speedometer2 me-2"></i>Vào trang quản lý</a>
                }
            </div>
        </div>
        <div class="col-lg-5">
            <div class="hero-stat-card">
                <i class="bi bi-stars fs-1"></i>
                <h4 class="mt-3">Thực đơn hôm nay</h4>
                <p class="mb-0">@Model.Count() món đang phục vụ, được phân loại rõ ràng và cập nhật theo thời gian thực.</p>
            </div>
        </div>
    </div>
</section>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-lg-6">
                <label class="form-label">Tìm món ăn</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input name="q" value="@ViewBag.Query" class="form-control" placeholder="Nhập tên món hoặc mô tả..." />
                </div>
            </div>
            <div class="col-lg-4">
                <label class="form-label">Danh mục</label>
                <select name="categoryId" class="form-select">
                    <option value="">Tất cả danh mục</option>
                    @foreach (var item in categories)
                    {
                        if (ViewBag.CategoryId != null && (int)ViewBag.CategoryId == item.MaDanhMuc)
                        {
                            <option value="@item.MaDanhMuc" selected>@item.TenDanhMuc</option>
                        }
                        else
                        {
                            <option value="@item.MaDanhMuc">@item.TenDanhMuc</option>
                        }
                    }
                </select>
            </div>
            <div class="col-lg-2 d-grid"><button class="btn btn-primary"><i class="bi bi-funnel me-1"></i>Lọc</button></div>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="empty-state"><i class="bi bi-search fs-1"></i><h4>Không tìm thấy món ăn</h4><p>Thử thay đổi từ khóa hoặc danh mục.</p></div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-sm-6 col-xl-3">
                <article class="card menu-card h-100 border-0 shadow-sm">
                    @if (!string.IsNullOrWhiteSpace(item.HinhAnh))
                    {
                        <img src="@item.HinhAnh" class="card-img-top menu-image" alt="@item.TenMon" />
                    }
                    else
                    {
                        <div class="menu-image-placeholder"><i class="bi bi-egg-fried"></i></div>
                    }
                    <div class="card-body d-flex flex-column">
                        <span class="small text-uppercase text-success fw-semibold">@item.DanhMucMonAn?.TenDanhMuc</span>
                        <h5 class="card-title mt-1">@item.TenMon</h5>
                        <p class="card-text text-secondary small flex-grow-1">@(item.MoTa ?? "Món ngon được chế biến trong ngày.")</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <strong class="fs-5 text-danger">@item.DonGia.ToString("N0") đ</strong>
                            <a class="btn btn-sm btn-outline-success" asp-controller="DatBan" asp-action="PublicCreate">Đặt bàn</a>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
}
