@model DashboardViewModel
@{
    ViewData["Title"] = "Tổng quan";
}
<div class="page-heading">
    <div><h1>Tổng quan nhà hàng</h1><p>Xin chào @User.Identity?.Name, đây là tình hình hoạt động hôm nay.</p></div>
    <div class="text-secondary"><i class="bi bi-calendar3 me-1"></i>@DateTime.Today.ToString("dd/MM/yyyy")</div>
</div>
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl"><div class="stat-card"><div class="stat-icon bg-soft-primary"><i class="bi bi-grid-3x3-gap"></i></div><div><span>Tổng số bàn</span><strong>@Model.TongBan</strong></div></div></div>
    <div class="col-sm-6 col-xl"><div class="stat-card"><div class="stat-icon bg-soft-success"><i class="bi bi-check2-circle"></i></div><div><span>Bàn trống</span><strong>@Model.BanTrong</strong></div></div></div>
    <div class="col-sm-6 col-xl"><div class="stat-card"><div class="stat-icon bg-soft-warning"><i class="bi bi-calendar-event"></i></div><div><span>Đặt bàn hôm nay</span><strong>@Model.DatBanHomNay</strong></div></div></div>
    <div class="col-sm-6 col-xl"><div class="stat-card"><div class="stat-icon bg-soft-info"><i class="bi bi-receipt"></i></div><div><span>Đơn đang xử lý</span><strong>@Model.DonDangPhucVu</strong></div></div></div>
    <div class="col-sm-12 col-xl"><div class="stat-card"><div class="stat-icon bg-soft-danger"><i class="bi bi-cash-stack"></i></div><div><span>Doanh thu hôm nay</span><strong>@Model.DoanhThuHomNay.ToString("N0") đ</strong></div></div></div>
</div>
<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3"><h5 class="mb-0">Thao tác nhanh</h5></div>
            <div class="card-body">
                <div class="row g-3 quick-actions">
                    <div class="col-md-4"><a asp-controller="DatBan" asp-action="Create"><i class="bi bi-calendar-plus"></i><span>Tạo đặt bàn</span></a></div>
                    <div class="col-md-4"><a asp-controller="DonGoiMon" asp-action="Create"><i class="bi bi-plus-square"></i><span>Tạo đơn gọi món</span></a></div>
                    <div class="col-md-4"><a asp-controller="HoaDon" asp-action="Pending"><i class="bi bi-credit-card"></i><span>Thanh toán</span></a></div>
                    <div class="col-md-4"><a asp-controller="BanAn" asp-action="Index"><i class="bi bi-grid"></i><span>Xem sơ đồ bàn</span></a></div>
                    <div class="col-md-4"><a asp-controller="KhachHang" asp-action="Index"><i class="bi bi-people"></i><span>Khách hàng</span></a></div>
                    <div class="col-md-4"><a asp-controller="ThongKe" asp-action="Index"><i class="bi bi-bar-chart"></i><span>Báo cáo</span></a></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3"><h5 class="mb-0">Món bán chạy 30 ngày</h5></div>
            <div class="card-body">
                @if (!Model.MonBanChay.Any())
                {
                    <p class="text-secondary">Chưa có dữ liệu bán hàng.</p>
                }
                else
                {
                    <ol class="list-group list-group-numbered list-group-flush">
                        @foreach (var item in Model.MonBanChay)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-start px-0">
                                <div class="ms-2 me-auto"><div class="fw-semibold">@item.TenMon</div><small class="text-secondary">@item.DoanhThu.ToString("N0") đ</small></div>
                                <span class="badge text-bg-success rounded-pill">@item.SoLuong</span>
                            </li>
                        }
                    </ol>
                }
            </div>
        </div>
    </div>
</div>
